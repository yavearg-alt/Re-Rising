# Re:Rising - server settings. Every value is optional; the server reads them from the environment
# (Windows: `set NAME=value` before starting, or edit start_local_server.bat; Linux/macOS: `export NAME=value`).
# Copy to .env if your tooling loads it. Never commit a real .env.

# --- network ---------------------------------------------------------------------------------------------------
# 127.0.0.1 = only this PC can connect (default). 0.0.0.0 = phones / other PCs on your network can connect too.
SAOUB_HOST=127.0.0.1
SAOUB_PORT=8080

# --- data (built from YOUR copy of the game, see README.md) ----------------------------------------------------
# folder holding server_cache/, extracted/ and dump/ (default: <repo>/data, or <repo>/dev_data when present)
SAOUB_DATA=
# your original SAO Unleash Blading 3.7.0 APK (default: <repo>/SAO+Unleash+Blading_3.7.0_APKPure.apk)
SAOUB_APK=
# player database (default: server/saoub.sqlite3)
SAOUB_DB=

# --- admin panel (off while the password is empty) -------------------------------------------------------------
SAOUB_ADMIN_PASSWORD=
SAOUB_ADMIN_HOST=127.0.0.1
SAOUB_ADMIN_PORT=8082

# --- optional ------------------------------------------------------------------------------------------------
# token for tools that call the API without a device id (header SAOAL-DEV-TOKEN); empty = disabled
SAOUB_DEV_TOKEN=
# internal API for a Discord bot; empty = disabled
SAOUB_BOT_SECRET=
SAOUB_BOT_HOST=127.0.0.1
SAOUB_BOT_PORT=8090
# name sent in the X-SAOUB-Server header and the welcome announcement
SAOUB_BRAND=

# --- build tools (tools/build_apk.sh, tools/fps_patch.py) --------------------------------------------------------
# JDK 21, Android build-tools (android-14: d8, zipalign, apksigner), apktool, android-31.jar (default: <data>/tools)
SAOUB_TOOLS=
# adb used by --install (default: BlueStacks' HD-Adb.exe)
SAOUB_ADB=
